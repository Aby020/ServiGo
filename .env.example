# ----------------------------------------------------------------------
# ServiGo — environment configuration
# Copy this file to `.env` and adjust values. NEVER commit `.env`.
# ----------------------------------------------------------------------

# --- Core ---
# Generate a secret key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

# Set to True only in development
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# --- Email (development uses console backend by default) ---
# Development: prints emails to the console (no real sending).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_USE_TLS=True
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
SERVER_EMAIL=
DEFAULT_FROM_EMAIL=

# --- Database ---
# The app defaults to SQLite (db.sqlite3). For PostgreSQL in production,
# override DATABASE_URL with e.g.:
# DATABASE_URL=postgres://user:password@localhost:5432/servigo
