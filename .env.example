# ----------------------------------------------------------------------
# ServiGo — environment configuration
# Copy this file to `.env` and adjust values. NEVER commit `.env`.
# ----------------------------------------------------------------------

# --- Core ---
# Generate a secret key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

# Set to True only in development
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# --- Email (development uses console backend by default) ---
# Development: prints emails to the console (no real sending).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_USE_TLS=True
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
SERVER_EMAIL=
DEFAULT_FROM_EMAIL=

# --- Database ---
# The app defaults to SQLite (db.sqlite3). For PostgreSQL in production
# (Render + Neon), set DATABASE_URL to the connection string:
# DATABASE_URL=postgres://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# --- Media storage (optional) ---
# Uploads go to MEDIA_ROOT by default. Set EITHER of the following in
# production to have every ImageField/FileField stored on Cloudinary instead:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_CLOUD_NAME=<cloud_name>

# --- CORS (optional) ---
# Comma-separated list of allowed origins for the API. Defaults to the local
# Next.js dev server. *.onrender.com and *.vercel.app are always allowed.
# CORS_ALLOWED_ORIGINS=https://app.servigo.com,https://www.servigo.com

# --- Seed command accounts (optional) ---
# `manage.py seed_demo` creates one shared password for all three demo
# accounts (customer@, staff@, admin@servigo.com). There is no default: with
# this unset the command exits with an error rather than create accounts
# behind a password written in the source. Any secret that satisfies the
# standard password policy works.
# SEED_DEMO_PASSWORD=<a secret of your choosing>
#
# `manage.py seed_production_data` (the Render build command) reads the same
# variable. To seed the catalogue without accounts at all, pass --skip-users
# instead.

# --- Rate limiting (optional) ---
# Defaults are shown. Anonymous API callers get the tighter budget because
# they are where credential guessing comes from.
# ANON_THROTTLE_RATE=20/min
# USER_THROTTLE_RATE=60/min
# HTML form limits: LOGIN_RATE_LIMIT attempts per LOGIN_RATE_WINDOW_SECONDS.
# LOGIN_RATE_LIMIT=10
# LOGIN_RATE_WINDOW_SECONDS=300
# REGISTER_RATE_LIMIT=5
# REGISTER_RATE_WINDOW_SECONDS=3600
